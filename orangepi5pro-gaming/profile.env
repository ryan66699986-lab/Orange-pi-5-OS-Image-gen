# Orange Pi 5 Pro gaming image profile.
PROFILE_VERSION="$(<"${REPO_ROOT}/VERSION")"
[[ "$PROFILE_VERSION" =~ ^[0-9]+\.[0-9]+$ ]] || { echo "Invalid repository VERSION: $PROFILE_VERSION" >&2; exit 1; }
PROFILE_NAME="orangepi5pro-gaming"

USER_NAME="ryan"
WORK="${HOME}/opi5pro-v${PROFILE_VERSION}-work"
OUT="${HOME}/opi5pro-images"
CACHE_ROOT="${OPI5PRO_CACHE_ROOT:-${HOME}/.cache/opi5pro-builder}"
DOWNLOAD_CACHE="${CACHE_ROOT}/downloads"
COMPILER_CACHE="${CACHE_ROOT}/compiler"
SOURCE_CACHE="${CACHE_ROOT}/git"
ARMBIAN_MIRROR="${SOURCE_CACHE}/armbian-build.git"
ART="${WORK}/artifacts"
SCRIPTS="${WORK}/scripts"
DOWNLOADS="${WORK}/downloads"
OVERLAY="${WORK}/overlay-root"
ARMBIAN="${WORK}/armbian"
LOCK="${WORK}/versions.lock.json"
LOG="${WORK}/build.log"
TIMING_LOG="${WORK}/stage-timings.tsv"

BOARD="orangepi5pro"
BRANCH="edge"
RELEASE="resolute"
ARCH="arm64"
BUILDER_IMAGE_REPOSITORY="opi5pro/ubuntu-resolute-arm64-builddeps"
BUILDER_IMAGE=""
ARMBIAN_REPOSITORY="https://github.com/armbian/build.git"

IMAGE_BASENAME="OPi-Gaming-OS-v${PROFILE_VERSION}-Orangepi5Pro-Ubuntu26.04-edge"
IMAGE_OUT="${OUT}/${IMAGE_BASENAME}.img"

# shellcheck disable=SC1090
source "${PROFILE_DIR}/sources.env"

HOST_JOBS="$(nproc 2>/dev/null || echo 4)"
if (( HOST_JOBS > 8 )); then JOBS=8; else JOBS="$HOST_JOBS"; fi
if (( JOBS < 2 )); then JOBS=2; fi
