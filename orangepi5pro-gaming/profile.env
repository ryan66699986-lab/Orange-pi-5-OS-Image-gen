# Orange Pi 5 Pro gaming image profile.
PROFILE_VERSION="3.10"
PROFILE_NAME="orangepi5pro-gaming"

USER_NAME="ryan"
WORK="${HOME}/opi5pro-v3.10-work"
OUT="${HOME}/opi5pro-images"
ART="${WORK}/artifacts"
SCRIPTS="${WORK}/scripts"
DOWNLOADS="${WORK}/downloads"
OVERLAY="${WORK}/overlay-root"
ARMBIAN="${WORK}/armbian"
LOCK="${WORK}/versions.lock.json"
LOG="${WORK}/build.log"

BOARD="orangepi5pro"
BRANCH="edge"
RELEASE="resolute"
ARCH="arm64"

IMAGE_BASENAME="OPi-Gaming-OS-v3.10-Orangepi5Pro-Ubuntu26.04-edge"
IMAGE_OUT="${OUT}/${IMAGE_BASENAME}.img"

# shellcheck disable=SC1090
source "${PROFILE_DIR}/sources.env"

HOST_JOBS="$(nproc 2>/dev/null || echo 4)"
if (( HOST_JOBS > 8 )); then JOBS=8; else JOBS="$HOST_JOBS"; fi
if (( JOBS < 2 )); then JOBS=2; fi
