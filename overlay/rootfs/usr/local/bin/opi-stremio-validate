#!/usr/bin/env bash
set -Eeuo pipefail

readonly media_lib=/opt/opi/media/lib:/opt/opi/media/lib64
readonly ffmpeg=/opt/opi/media/bin/ffmpeg
readonly mpv=/opt/opi/media/bin/mpv
readonly state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/opi"
readonly stremio_log="${state_dir}/stremio.log"

export LD_LIBRARY_PATH="${media_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

stack_check() {
    [[ "$(uname -m)" == aarch64 ]] || { echo 'FAIL: this check must run on ARM64' >&2; exit 1; }
    [[ -x /opt/stremio/stremio ]] || { echo 'FAIL: native Stremio is missing' >&2; exit 1; }
    [[ -x "${ffmpeg}" && -x "${mpv}" ]] || { echo 'FAIL: dedicated media tools are missing' >&2; exit 1; }
    compgen -G '/dev/video*' >/dev/null || { echo 'FAIL: the kernel exposes no V4L2 video device' >&2; exit 1; }
    "${ffmpeg}" -hide_banner -hwaccels 2>&1 | grep -qi v4l2request || {
        echo 'FAIL: dedicated FFmpeg does not expose v4l2request' >&2
        exit 1
    }
    "${mpv}" --no-config --hwdec=help 2>&1 | grep -qi v4l2request || {
        echo 'FAIL: dedicated mpv does not expose v4l2request' >&2
        exit 1
    }
    grep -aFq v4l2request-copy /opt/stremio/stremio || {
        echo 'FAIL: Stremio lacks the enforced v4l2request-copy policy' >&2
        exit 1
    }
    echo 'PASS: native Stremio and the dedicated V4L2 Request stack are present'
}

file_check() {
    local input="${1:-}" log
    [[ -n "${input}" && -r "${input}" ]] || {
        echo 'Usage: opi-stremio-validate file VIDEO' >&2
        exit 2
    }
    install -d -m0700 "${state_dir}"
    log="${state_dir}/mpv-v4l2request-check.log"
    if "${mpv}" --no-config --vo=null --ao=null --frames=120 \
        --hwdec=v4l2request-copy --hwdec-codecs=all \
        --msg-level=all=warn,vd=debug "${input}" >"${log}" 2>&1 &&
        grep -Eqi 'Using hardware decoding.*v4l2request' "${log}"; then
        echo "PASS: hardware decoded ${input} through v4l2request-copy"
        return 0
    fi
    echo "FAIL: ${input} did not prove v4l2request-copy decoding; inspect ${log}" >&2
    exit 1
}

playback_check() {
    [[ -s "${stremio_log}" ]] || {
        echo "FAIL: play a video in Stremio first; no log exists at ${stremio_log}" >&2
        exit 1
    }
    grep -Eqi 'Using hardware decoding.*v4l2request' "${stremio_log}" || {
        echo "FAIL: Stremio playback has no v4l2request hardware-decoding evidence; inspect ${stremio_log}" >&2
        exit 1
    }
    echo 'PASS: real Stremio playback used V4L2 Request hardware decoding'
    echo 'Visual picture, colour, frame pacing and audio sync still require human confirmation.'
}

case "${1:-stack}" in
    stack) stack_check ;;
    file) stack_check; file_check "${2:-}" ;;
    playback) stack_check; playback_check ;;
    *) echo 'Usage: opi-stremio-validate [stack|file VIDEO|playback]' >&2; exit 2 ;;
esac
